-- [MODIFIKASI ANALYTICS] LIVE UPDATER LOOP
local frameUpdate = 0
RunService.RenderStepped:Connect(function()
    frameUpdate = frameUpdate + 1
end)

task.spawn(function()
    while task.wait(1) do
        -- Update Live FPS ke HUD
        fpsLabel.Text = "FPS: " .. tostring(frameUpdate)
        frameUpdate = 0 -- Reset frame untuk detik berikutnya
        
        if not renderingEnabled then
            local currentCash = getPlayerMoney()
            
            -- Kalkulasi Live Analytics (Waktu & Profit Per Jam)
            local elapsedTime = os.time() - sessionStartTime
            local mph = 0
            local rph = 0
            if elapsedTime > 0 then
                mph = math.floor((totalMoneyEarned / elapsedTime) * 3600)
                rph = math.floor((sessionRaces / elapsedTime) * 3600)
            end
            
            -- Format Waktu menjadi HH:MM:SS
            local h = math.floor(elapsedTime / 3600)
            local m = math.floor((elapsedTime % 3600) / 60)
            local s = elapsedTime % 60
            local timeString = string.format("%02d:%02d:%02d", h, m, s)
            
            -- Update Teks Black Screen
            bsText.Text = "RENDERING 3D DINONAKTIFKAN\n(Mode Auto-Farm Berjalan)\n\n" ..
                          "💰 Uang Saat Ini : $" .. tostring(currentCash) .. "\n" ..
                          "📈 Profit Sesi   : $" .. tostring(totalMoneyEarned) .. "\n" ..
                          "🏁 Total Balapan : " .. tostring(sessionRaces) .. "\n\n" ..
                          "📊 LIVE ANALYTICS\n" ..
                          "⏱️ Waktu Berjalan : " .. timeString .. "\n" ..
                          "💸 Money/Hour     : $" .. tostring(mph) .. "\n" ..
                          "🏎️ Races/Hour     : " .. tostring(rph) .. "\n\n" ..
                          "Klik 'NEON DARK' di Hub untuk menampilkan game."
        end
    end
end)

game:BindToClose(function() sendWebhook(STATUS_WEBHOOK, 0, totalMoneyEarned, sessionRaces, true) end)
